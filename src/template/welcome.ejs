
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to APONZO</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="padding: 40px 15px;"
  >
    <tr>
      <td align="center">

        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 560px;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
          "
        >

          <!-- Header -->
          <tr>
            <td
              align="center"
              style="
                background: #111827;
                padding: 28px 20px;
              "
            >
              <h1 style="
                margin: 0;
                color: #ffffff;
                font-size: 28px;
                font-weight: 700;
              ">
                APONZO
              </h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px;">

              <h2 style="
                margin: 0 0 20px;
                color: #111827;
                font-size: 24px;
              ">
                Welcome to APONZO
              </h2>

              <p style="
                margin: 0 0 15px;
                color: #374151;
                font-size: 16px;
                line-height: 1.6;
              ">
                Hi <%= name %>,
              </p>

              <p style="
                margin: 0 0 25px;
                color: #4b5563;
                font-size: 15px;
                line-height: 1.7;
              ">
                Welcome to APONZO! Your account has been successfully
                created. We're excited to have you with us.
              </p>

              <p style="
                margin: 0 0 25px;
                color: #4b5563;
                font-size: 15px;
                line-height: 1.7;
              ">
                You can now explore our platform, discover products,
                and enjoy a simple and convenient shopping experience.
              </p>

              <!-- Get Started Button -->
             

              <p style="
                margin: 0 0 10px;
                color: #6b7280;
                font-size: 13px;
                line-height: 1.6;
              ">
                If you have any questions, our support team is always
                here to help.
              </p>

              <p style="
                margin: 25px 0 8px;
                color: #6b7280;
                font-size: 13px;
              ">
                You can visit APONZO using the link below:
              </p>

                

              <hr style="
                margin: 30px 0;
                border: 0;
                border-top: 1px solid #e5e7eb;
              " />

              <p style="
                margin: 0;
                color: #9ca3af;
                font-size: 12px;
                line-height: 1.6;
              ">
                If you didn't create an account with APONZO,
                please contact our support team.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                padding: 20px;
                background: #f9fafb;
                border-top: 1px solid #e5e7eb;
              "
            >
              <p style="
                margin: 0;
                color: #9ca3af;
                font-size: 12px;
              ">
                © <%= year %> APONZO. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>

