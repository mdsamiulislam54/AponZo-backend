model Stores {
  id                 String        @id @default(cuid())
  name               String
  slug               String?       @unique
  description        String?
  logo               String?
  banner             String?
  type               Stores_Type   @default(INDIVIDUAL)
  status             Store_Status  @default(ACTIVE)
  isVerified         Boolean       @default(false)
  rating             Float         @default(0)
  totalReviews       Int           @default(0)
  totalOrders        Int           @default(0)
  totalProducts      Int           @default(0)
  totalSoldItems     Int           @default(0)
  insideDeliveryFee  Float         @default(0.0)
  outsideDeliveryFee Float         @default(0.0)
  insideDeliveryDay  Int           @default(0)
  outsideDeliveryDay Int           @default(0)
  totalSales         Float         @default(0.0)
  sellerId           String        @unique
  seller             Seller       @relation(fields: [sellerId], references: [id],onDelete: Cascade, onUpdate: Cascade)
  Products           Products[]
  isDeleted          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum Stores_Type {
    PHYSICAL
    ONLINE
    INDIVIDUAL
}

enum Store_Status {
    ACTIVE
    INACTIVE
    DRAFT
    SUSPENDED
    BANDED
}

